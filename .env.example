# Browser key: restrict by HTTP referrer and to Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=

# Server only. Never use a VITE_ prefix for the OpenAI key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Shared cloud backend (leave empty for an isolated local SQLite database).
CLOUD_API_ORIGIN=https://clara-agua-comunidad.nicelemur6.chatgpt.site
OPENAI_VISION_MODEL=gpt-5.4-mini

# Account authentication (server only; NEVER prefix these with VITE_).
AUTH_ORIGIN=http://localhost:5181
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Demo only: honored by local Express on localhost; unavailable in Worker.
AUTH_DEMO_EMAIL_VERIFICATION=0
